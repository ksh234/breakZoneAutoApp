# ── 시크릿 (절대 커밋 금지) ──
.env
.env.*
!.env.example
!**/.env.example
*.local
google-services*.json
GoogleService-Info.plist
*serviceAccount*.json
*secret*.json

# ── Python (engine) ──
.venv/
__pycache__/
*.pyc
.pytest_cache/
logs/
*.log

# ── Flutter (app) ──
app/.dart_tool/
app/build/
app/.flutter-plugins*
app/ios/Pods/
app/.idea/
# 앱 시크릿(URL·publishable key) — 커밋 금지
app/lib/core/env.dart
!app/lib/core/env.example.dart

# ── Supabase ──
supabase/.branches/
supabase/.temp/

# ── OS/에디터 ──
.DS_Store
Thumbs.db
.vscode/
