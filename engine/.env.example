# engine 환경변수 예시 — 이 파일을 복사해서 `.env` 로 만들고 실제 값을 채운다.
#   PowerShell:  Copy-Item .env.example .env
# ⚠️ `.env` 는 절대 깃에 커밋하지 않는다(.gitignore 처리됨). 이 예시 파일에는 실제 값 금지.

# ── 키움 REST API ──
KIWOOM_MODE=demo                 # demo(모의) | real(실전).  1단계는 demo 고정.
KIWOOM_APP_KEY=여기에_모의_App_Key
KIWOOM_SECRET=여기에_모의_App_Secret
KIWOOM_ACCOUNT_NO=여기에_모의계좌번호

# ── Supabase (Phase 3부터 사용) ──
SUPABASE_URL=                    # Project Settings>Data API>Project URL (https://xxxx.supabase.co)
SUPABASE_SECRET_KEY=             # 봇 전용 secret key(sb_secret_…). 서버 전용, 앱/깃 금지.
                                 #   (legacy service_role 를 SUPABASE_SERVICE_ROLE_KEY 로 넣어도 폴백 동작)
SUPABASE_OWNER_UUID=             # Authentication>Users 에서 만든 사용자의 UID

# ── 봇 인스턴스 (클라우드 이관 후) ──
BOT_DRY_RUN=0                    # 1=드라이런: 주문·Supabase 쓰기 전부 금지, 판정 로그만. PC 에서 새 코드 관찰용.
                                 #   클라우드 이관 후 PC .env 는 1 로 두는 것을 권장(이중 주문 원천 차단).
BOT_HOLDER_ID=                   # 락 보유자 이름(비우면 호스트명). 예: cloud-seoul / home-pc
BOT_LOCK_STALE_SEC=90            # 이 초 이상 하트비트 없으면 다른 봇이 락 승계
BOT_LOCK_RENEW_SEC=15            # 락 갱신·재시도 주기(초)

# ── 기타 ──
LOG_LEVEL=INFO
