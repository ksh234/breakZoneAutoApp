# engine 환경변수 예시 — 이 파일을 복사해서 `.env` 로 만들고 실제 값을 채운다.
#   PowerShell:  Copy-Item .env.example .env
# ⚠️ `.env` 는 절대 깃에 커밋하지 않는다(.gitignore 처리됨). 이 예시 파일에는 실제 값 금지.

# ── 키움 REST API ──
KIWOOM_MODE=demo                 # demo(모의) | real(실전).  1단계는 demo 고정.
KIWOOM_APP_KEY=여기에_모의_App_Key
KIWOOM_SECRET=여기에_모의_App_Secret
KIWOOM_ACCOUNT_NO=여기에_모의계좌번호

# ── Supabase (Phase 3부터 사용) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=       # 봇 전용(서버). 앱엔 절대 미포함.

# ── 기타 ──
LOG_LEVEL=INFO
